{
  "@for": {
    "prefix": ["@for", "a-for", "ngfor", "for"],
    "body": [
      "@for (${1:item} of ${2:items}; track ${3:$1.id}) {",
      "  $0",
      "} @empty {",
      "  <p>${4:Nenhum registo encontrado.}</p>",
      "}"
    ],
    "description": "Angular 17+ Modern Control Flow @for loop"
  },
  "@if": {
    "prefix": ["@if", "a-if", "ngif", "if"],
    "body": [
      "@if (${1:condition}) {",
      "  $0",
      "} @else {",
      "  ",
      "}"
    ],
    "description": "Angular 17+ Modern Control Flow @if block"
  },
  "@switch": {
    "prefix": ["@switch", "a-switch", "switch"],
    "body": [
      "@switch (${1:condition}) {",
      "  @case (${2:value}) {",
      "    $0",
      "  }",
      "  @default {",
      "    ",
      "  }",
      "}"
    ],
    "description": "Angular 17+ Modern Control Flow @switch block"
  },
  "@defer": {
    "prefix": ["@defer", "a-defer", "defer"],
    "body": [
      "@defer (on ${1:viewport}) {",
      "  $0",
      "} @loading {",
      "  <p>A carregar...</p>",
      "} @placeholder {",
      "  <p>Placeholder</p>",
      "} @error {",
      "  <p>Falha ao carregar componente.</p>",
      "}"
    ],
    "description": "Angular 17+ Deferrable View block"
  },
  "HTML5 Boilerplate": {
    "prefix": ["html5", "!"],
    "body": [
      "<!DOCTYPE html>",
      "<html lang=\"pt\">",
      "<head>",
      "  <meta charset=\"UTF-8\">",
      "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">",
      "  <title>${1:Document}</title>",
      "</head>",
      "<body>",
      "  $0",
      "</body>",
      "</html>"
    ],
    "description": "HTML5 boilerplate structure"
  },
  "HTML Button with Click": {
    "prefix": ["btn", "button"],
    "body": [
      "<button type=\"${1:button}\" class=\"${2:btn}\" (click)=\"${3:onClick}()\">",
      "  ${4:Clique Aqui}",
      "</button>$0"
    ],
    "description": "Button with Angular (click) binding"
  },
  "Form Group Input": {
    "prefix": ["forminput", "nginputgroup"],
    "body": [
      "<div class=\"form-group\">",
      "  <label for=\"${1:id}\">${2:Label}</label>",
      "  <input type=\"${3:text}\" id=\"${1:id}\" [formControl]=\"${4:control}\" class=\"form-control\" placeholder=\"${5:placeholder}\">",
      "</div>$0"
    ],
    "description": "Form input with reactive form control"
  }
}
